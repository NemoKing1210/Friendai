#!/bin/sh
# Local Conventional Commits check (same rules as commitlint.config.mjs). No Node needed.
# Enable once per clone: git config core.hooksPath .githooks
header="$(head -n 1 "$1")"

case "$header" in
  Merge\ *|Revert\ \"*|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^A-Z.](.*[^.])?$'
if ! printf '%s' "$header" | grep -Eq "$pattern"; then
  echo "Invalid commit message: $header" >&2
  echo "Expected: <type>(<optional scope>): <lowercase subject without trailing period>" >&2
  echo "Types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

if [ "${#header}" -gt 100 ]; then
  echo "Commit header is longer than 100 characters." >&2
  exit 1
fi
